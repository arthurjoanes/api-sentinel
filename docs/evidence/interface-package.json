    "route_probe_source": "import hashlib\nimport json\nimport tempfile\nfrom pathlib import Path\n\nfrom fastapi.testclient import TestClient\n\nfrom alert_receiver.app import RUNBOOKS, create_app\nfrom alert_receiver.config import Settings\n\nroot = Path('/app')\nfiles = {\n    path.relative_to(root).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()\n    for path in sorted(root.rglob('*'))\n    if path.is_file() and '__pycache__' not in path.parts and path.suffix != '.pyc'\n}\nroutes = []\nwith tempfile.TemporaryDirectory() as temporary:\n    directory = Path(temporary)\n    token = directory / 'token'\n    token.write_text('package-check-token-not-a-deployment-secret-20260922')\n    app = create_app(Settings(\n        database_path=directory / 'alerts.sqlite3',\n        webhook_token_file=token,\n        probe_enabled=False,\n    ))\n    with TestClient(app) as client:\n        paths = ['/', '/health/live', '/styles.css', '/snapshot.js', '/runbooks']\n        paths.extend(f'/runbooks/{slug}' for slug in sorted(RUNBOOKS))\n        paths.append('/runbooks/not-a-runbook')\n        for path in paths:\n            response = client.get(path)\n            expected = 404 if path.endswith('not-a-runbook') else 200\n            assert response.status_code == expected, (path, response.status_code)\n            if path in ('/styles.css', '/snapshot.js'):\n                source = root / 'alert_receiver' / path.removeprefix('/')\n                assert response.content == source.read_bytes()\n            if path.startswith('/runbooks/') and expected == 200:\n                assert '<h1' in response.text\n                assert 'Runbook temporariamente indisponível' not in response.text\n            routes.append({\n                'path': path,\n                'status': response.status_code,\n                'content_type': response.headers['content-type'],\n            })\nprint(json.dumps({'files_sha256': files, 'routes': routes}, indent=2))\n",
