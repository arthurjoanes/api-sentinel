            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(rate(sentinel_http_requests_total{traffic=\"business\",outcome=\"server_error\",route=~\"/v1/stores|/v1/stores/.*/(summary|sales)\"}[$__rate_interval])) or (sum(rate(sentinel_http_requests_total{traffic=\"business\",outcome=~\"success|server_error\",route=~\"/v1/stores|/v1/stores/.*/(summary|sales)\"}[$__rate_interval])) * 0)) / sum(rate(sentinel_http_requests_total{traffic=\"business\",outcome=~\"success|server_error\",route=~\"/v1/stores|/v1/stores/.*/(summary|sales)\"}[$__rate_interval])))",
          "legendFormat": "Disponibilidade nas rotas principais",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
