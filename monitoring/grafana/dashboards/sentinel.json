    {
      "id": 10,
      "title": "Disponibilidade na API",
      "type": "timeseries",
      "description": "Sucessos/(sucessos+5xx), rotas stores/summary/sales, tráfego business. 429/4xx e ERP opcional separados. Sem tráfego: indefinido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
