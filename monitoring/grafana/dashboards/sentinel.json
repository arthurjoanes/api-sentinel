{
  "id": null,
  "uid": "sentinel",
  "title": "API Sentinel",
  "description": "Métricas da API, dependências e alertas.",
  "tags": [
    "api-sentinel",
    "laboratório"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "links": [
    {
      "title": "Central de alertas",
      "url": "http://localhost:9184",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Traces no Jaeger",
      "url": "http://localhost:16684",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Prometheus / targets",
      "url": "http://localhost:9104/targets",
      "type": "link",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Rota normalizada",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(sentinel_http_requests_total, route)",
        "query": {
          "query": "label_values(sentinel_http_requests_total, route)",
          "refId": "route-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Investigação",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Selecione o período do incidente. Compare probe e réplicas; abra o [runbook](http://localhost:9184)."
      }
    },
    {
      "id": 2,
      "title": "Probe pelo proxy",
      "type": "stat",
      "description": "0=falha; 1=status, schema e fixture corretos. Ausência significa observação indisponível.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Sem observação",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Falha",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Validada",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sentinel_probe_success)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
